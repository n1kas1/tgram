# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# PostgreSQL connection string (async driver). On Railway/Supabase copy the
# connection string and prefix the scheme with "+asyncpg".
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# Comma-separated Telegram IDs of financiers (admins).
FINANCIER_TG_IDS=123456789,987654321

# Optional: who receives /admin_message notes (defaults to the first financier).
ADMIN_TG_ID=

# Optional: users per broadcast batch (default 80).
BROADCAST_BATCH=80

# Optional: hours between auto-reminders for campaigns with a deadline (default 24).
REMIND_INTERVAL_HOURS=24
